body {
  font-family: Arial, sans-serif;
  background-color: #121212;
  color: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  margin: 0;
}

#container {
  text-align: center;
}

#controls {
  margin: 15px 0;
}

button {
  background-color: #1ed760;
  border: none;
  color: #000;
  padding: 10px 18px;
  font-size: 14px;
  font-weight: bold;
  margin: 0 5px;
  border-radius: 20px;
  cursor: pointer;
  transition: transform 0.1s;
}

button:hover {
  transform: scale(1.05);
}

#canvas-holder {
  margin-top: 10px;
  border: 2px solid #333;
  border-radius: 8px;
  display: inline-block;
  overflow: hidden;
}
