let osc, fft;
let baseNotes = [261.63, 293.66, 329.63, 349.23, 392.00, 440.00, 493.88, 523.25]; // C4 到 C5
let currentNotes = [...baseNotes];
let currentStep = 0;
let isPlaying = false;
let intervalId = null;

let pitchShifted = false;
let isReversed = false;
let statusMessage = "Click Canvas to Start Audio";

function setup() {
  let canvas = createCanvas(600, 300);
  canvas.parent('canvas-holder');

  // 初始化正弦波振荡器与 FFT 频谱分析器
  osc = new p5.Oscillator('sine');
  osc.amp(0);
  
  fft = new p5.FFT();

  // 绑定按钮事件
  select('#btn-reverse').mousePressed(toggleReverse);
  select('#btn-pitch').mousePressed(togglePitch);
  select('#btn-reset').mousePressed(resetMelody);
}

function draw() {
  background(20);

  // 绘制底部波形反馈 (Response & Feedback)
  let waveform = fft.waveform();
  noFill();
  stroke(30, 215, 96);
  strokeWeight(2);
  beginShape();
  for (let i = 0; i < waveform.length; i++) {
    let x = map(i, 0, waveform.length, 0, width);
    let y = map(waveform[i], -1, 1, height - 80, height - 10);
    vertex(x, y);
  }
  endShape();

  // 绘制旋律音符节点指示器
  let stepWidth = width / currentNotes.length;
  for (let i = 0; i < currentNotes.length; i++) {
    let x = i * stepWidth + stepWidth / 2;
    let y = map(currentNotes[i], 200, 1100, height - 100, 40);

    if (isPlaying && i === currentStep) {
      fill(255, 100, 100); // 当前播放的高亮颜色
      ellipse(x, y, 24, 24);
    } else {
      fill(100, 100, 255);
      ellipse(x, y, 14, 14);
    }
  }

  // 状态与错误/提示文字反馈
  fill(255);
  noStroke();
  textSize(14);
  textAlign(LEFT, TOP);
  text(`Status: ${statusMessage}`, 15, 15);
  text(`Reverse: ${isReversed ? "ON" : "OFF"} | Pitch+1 Octave: ${pitchShifted ? "ON" : "OFF"}`, 15, 35);
}

// 容错机制：通过用户明确点击 Canvas 激活 AudioContext（规避浏览器自动播放限制）
function mousePressed() {
  if (mouseX >= 0 && mouseX <= width && mouseY >= 0 && mouseY <= height) {
    if (!isPlaying) {
      userStartAudio(); // 启动 p5 音频引擎
      osc.start();
      isPlaying = true;
      statusMessage = "Playing melody loop...";
      
      // 定时循环播放音符
      intervalId = setInterval(nextNote, 300);
    } else {
      stopAudio();
    }
  }
}

function nextNote() {
  currentStep = (currentStep + 1) % currentNotes.length;
  let freq = currentNotes[currentStep];
  
  osc.freq(freq, 0.05);
  osc.amp(0.3, 0.05); // 播放音符
  setTimeout(() => osc.amp(0, 0.05), 200); // 音符衰减
}

function stopAudio() {
  isPlaying = false;
  if (intervalId) clearInterval(intervalId);
  osc.amp(0, 0.1);
  statusMessage = "Audio Stopped. Click canvas to resume.";
}

// 交互操作 1：反转旋律
function toggleReverse() {
  isReversed = !isReversed;
  currentNotes.reverse();
  statusMessage = isReversed ? "Melody Reversed!" : "Melody Normal Order";
}

// 交互操作 2：升高八度
function togglePitch() {
  pitchShifted = !pitchShifted;
  let factor = pitchShifted ? 2 : 1;
  currentNotes = baseNotes.map(f => f * factor);
  if (isReversed) currentNotes.reverse();
  statusMessage = pitchShifted ? "Pitch shifted +1 Octave" : "Pitch reset to Normal";
}

// 重置控制
function resetMelody() {
  isReversed = false;
  pitchShifted = false;
  currentNotes = [...baseNotes];
  statusMessage = "Melody Reset to Default";
}
