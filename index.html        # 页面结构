<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interactive Melody Synthesizer</title>
  <link rel="stylesheet" href="style.css">
  <!-- 引入 p5.js 及 p5.sound 库 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.11.3/p5.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.11.3/addons/p5.sound.min.js"></script>
</head>
<body>
  <div id="container">
    <h1>Interactive Melody Synthesizer</h1>
    <p>Click anywhere on the canvas to Start/Stop audio engine.</p>
    <div id="controls">
      <button id="btn-reverse">Reverse Melody</button>
      <button id="btn-pitch">Pitch Up (+Octave)</button>
      <button id="btn-reset">Reset Melody</button>
    </div>
    <div id="canvas-holder"></div>
  </div>
  <script src="sketch.js"></script>
</body>
</html>
